APP_NAME="Event Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=event_hub
DB_USERNAME=event_hub
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MoneyFusion (laravel-moneyfusion) : https://docs.moneyfusion.net/fr/webapi
# URL et cle fournies par le dashboard FusionPay. L'IP du serveur doit etre autorisee dans le dashboard.
# Hote : pay.moneyfusion.net (sans "www.") ; www.pay.moneyfusion.net refuse la connexion TLS (constate le 2026-10-20).
# "Application non approuvee." = application a valider ou IP du serveur a autoriser chez MoneyFusion.
MONEYFUSION_API_URL=
MONEYFUSION_APP_KEY=
MONEYFUSION_CHECK_PAYMENT_URL=https://pay.moneyfusion.net/paiementNotif
# Webhook / retour : HTTPS public obligatoire (en local, utiliser un tunnel et definir APP_URL)
MONEYFUSION_VERIFY_SSL=true

# Traduction automatique des fichiers lang/*.json (php artisan deepl:translate en)
GEOCODING_ENABLED=true
GEOCODING_USER_AGENT="EventHub/1.0 (contact@exemple.com)"

DEEPL_API_KEY=
DEEPL_SOURCE_LANG=fr
DEEPL_FORMALITY=
DEEPL_CACHE=true
